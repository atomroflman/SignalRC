**/bin/**/*
**/obj/**/*
**/packages/**/*
.idea/**
.vscode/**
*.suo
*.user
**/*.crt

# Onboard excludes
Onboard/Extern/mediamtx
__pycache__/
*.py[cod]

# Server excludes
SignalRC.Server/CarConfigStore/**/*
SignalRC.Server/wwwroot/**/*
SignalRC.Server/bash/dotnet-install.sh
SignalRC.Server/janus/janus-gateway/**/*
/.vs/**
SignalRC.Server/configuration.db*
Builds/*/ssh_key
